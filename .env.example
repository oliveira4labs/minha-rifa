# Copie para .env e ajuste. Usado pelo docker-compose e pelo backend.

# Postgres do docker-compose
POSTGRES_USER=rifa
POSTGRES_PASSWORD=rifa
POSTGRES_DB=minha_rifa
# Porta no seu computador (5433 para não conflitar com outro Postgres na 5432)
POSTGRES_HOST_PORT=5433

# Porta da aplicação quando roda pelo docker-compose
APP_HOST_PORT=3000

# Backend rodando fora do Docker (npm run dev / npm start)
DATABASE_URL=postgres://rifa:rifa@localhost:5433/minha_rifa
# Pasta das fotos enviadas
# DATA_DIR=./apps/backend/data
